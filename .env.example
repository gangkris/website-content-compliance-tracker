# Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Project Settings -> API -> service_role (secret). Server-only,
# never prefix with NEXT_PUBLIC_, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# platform.claude.com -> API Keys. Server-only.
ANTHROPIC_API_KEY=

# resend.com -> API Keys. Server-only. Used by the daily expiration-check job
# to send reminder emails.
RESEND_API_KEY=

# Must be a sender Resend allows: onboarding@resend.dev in sandbox mode
# (deliverable only to your own Resend account email), or an address on a
# domain you've verified in Resend.
RESEND_FROM_EMAIL=onboarding@resend.dev
